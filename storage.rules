rules_version = '2';

// Product and content imagery. Readable by anyone, writable only by admins,
// and capped so an upload cannot be used to fill the bucket.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isImageUnder(megabytes) {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|webp|avif)')
        && request.resource.size < megabytes * 1024 * 1024;
    }

    match /products/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImageUnder(5);
    }

    match /content/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImageUnder(5);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
